<Project>
  <PropertyGroup>
    <DmfDarkwoodDir Condition="'$(DmfDarkwoodDir)' == ''">$(DMF_DARKWOOD_DIR)</DmfDarkwoodDir>
    <DmfDependencyDir Condition="'$(DmfDependencyDir)' == ''">$(DMF_DEPENDENCY_DIR)</DmfDependencyDir>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\artifacts-local\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\artifacts-local\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;src-staging\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
